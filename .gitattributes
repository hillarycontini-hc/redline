# Default: let git normalise text in the repo and convert on checkout.
* text=auto

# Test data is bytes, not source. The citation check locates a quoted sentence
# inside these files, so they must read identically on every machine and in CI.
# Without this, a Windows checkout gets CRLF and Linux gets LF, and a quote that
# spans a line break is a different string on each.
tests/fixtures/*.txt   text eol=lf
tests/fixtures/*.json  text eol=lf
gold-set/**/*.txt      text eol=lf
gold-set/**/*.json     text eol=lf

# Binary test fixtures. A PDF's cross-reference table is a list of byte offsets
# into the file, so a single line-ending conversion shifts every offset after it
# and the document stops opening. Git's text=auto heuristic reads a hand-built
# PDF as text, because it is mostly ASCII and carries no NUL byte, and converts
# it. Say binary explicitly rather than relying on the guess.
*.pdf   binary
*.docx  binary
