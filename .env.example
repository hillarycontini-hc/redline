# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never commit a real key. A key is public the moment it is pushed.

# OpenRouter API key. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id, e.g. "anthropic/claude-sonnet-4.5". Deliberately unset here:
# the model is chosen by the product owner, never hardcoded.
OPENROUTER_MODEL=
