{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:citations": "node --test src/lib/analysis/citation-check.test.ts src/lib/analysis/fixture-citations.test.ts",
    "smoke": "node --env-file=.env.local --experimental-strip-types scripts/smoke.ts",
    "smoke:clean": "node --env-file=.env.local --experimental-strip-types scripts/smoke.ts --clean"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.1"
}
