{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:citations": "node --test src/lib/analysis/citation-check.test.ts src/lib/analysis/fixture-citations.test.ts",
    "smoke": "node --env-file=.env.local --experimental-strip-types scripts/smoke.ts",
    "smoke:clean": "node --env-file=.env.local --experimental-strip-types scripts/smoke.ts --clean",
    "gates": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/gates.ts",
    "verify:rls": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-rls.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "mammoth": "^1.13.0",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.1"
}
