# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never commit a real key. A key is public the moment it is pushed.

# OpenRouter API key. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id, e.g. "anthropic/claude-sonnet-4.5". Deliberately unset here:
# the model is chosen by the product owner, never hardcoded.
OPENROUTER_MODEL=

# Supabase. Both of these, or neither: half a configuration is not one.
# Redline runs without them — reading a document never needed an account. What
# goes is the library and your own red lines, and the screens for both say so.
# Project settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Two throwaway accounts on that project, used only by `pnpm verify:rls`, which
# proves one account cannot read another's rows. See
# supabase/migrations/README.md. Leave these empty unless you are running it.
REDLINE_RLS_EMAIL_A=
REDLINE_RLS_PASSWORD_A=
REDLINE_RLS_EMAIL_B=
REDLINE_RLS_PASSWORD_B=
